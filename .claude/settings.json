{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_note_style.py\" --hook",
            "timeout": 30,
            "statusMessage": "Checking note style"
          }
        ]
      }
    ]
  }
}
